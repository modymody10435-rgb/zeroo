# اسم التطبيق الظاهر في الواجهة وواجهة API
APP_TITLE=نظام إدارة مخزن المعمل

# استضافة التطبيق
WAREHOUSE_HOST=0.0.0.0
WAREHOUSE_PORT=8000

# عناوين الوكلاء الموثوقة لقراءة X-Forwarded-*. اتركه 127.0.0.1 خلف Nginx محلي.
# FORWARDED_ALLOW_IPS=127.0.0.1

# مسار قاعدة البيانات الجديدة. استخدم مساراً مطلقاً في الإنتاج.
WAREHOUSE_DB_PATH=data/warehouse.sqlite3

# مصدر الترحيل الأولي من التطبيق القديم (اختياري)
OFFLINE_DB_PATH=data/offline.db
MIGRATE_OFFLINE_DB=1

# بيانات مدير النظام الأولية. غيّر كلمة المرور قبل أول تشغيل في الإنتاج.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# الجلسات وملف تعريف الارتباط
SESSION_DAYS=14
COOKIE_NAME=warehouse_session
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# اتركه فارغاً عند استخدام نفس النطاق. أضف النطاقات المفصولة بفواصل عند الحاجة.
TRUSTED_ORIGINS=
